<?xml version="1.0"?>
<ruleset name="Send4WC">
	<description>WordPress Coding Standards for Send4 for WooCommerce.</description>

	<file>send4-for-woocommerce.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>admin</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/dev/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<!--
		Core + Docs + Extra. WordPress.WP.AlternativeFunctions, which is what
		enforces "no curl, no file_get_contents on a URL", ships in Extra only.
	-->
	<rule ref="WordPress"/>

	<!-- The plugin header says "Requires PHP: 7.4", so that is what is tested. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- The plugin header's "Requires at least": 6.5 reads Requires Plugins. -->
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="send4wc"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="send4-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<!--
		Everything below narrows a sniff to the files where it is right, or turns
		it off where the plugin code is right and the sniff cannot see why. None
		of these was added to silence a real defect.
	-->

	<!--
		The one-minute schedule is deliberate: the queue's first retry is a
		minute after a failed submission, and a coarser interval would make that
		promise a lie. The class already documents the reasoning.
	-->
	<rule ref="WordPress.WP.CronInterval.CronSchedulesInterval">
		<exclude-pattern>includes/class-send4wc-cron.php</exclude-pattern>
	</rule>
</ruleset>
